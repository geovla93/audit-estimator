  "formulaOracle": {
    "fixture": "examples/projects/simple",
    "sourceFile": "src/Vault.sol",
    "sourceLines": 7,
    "countingNote": "The seven code-bearing physical lines are pragma, contract declaration, state declaration, function declaration, assignment, and two closing braces. The blank line is not source code.",
    "projectHours": { "low": 4, "high": 12 },
    "slocHours": { "low": 0.04, "high": 0.12 },
    "hoursPerDay": 8,
    "defaultHours": { "low": 4, "high": 13 },
    "defaultDays": { "low": 0.5, "high": 1.7 },
    "defaultLedger": [
      {
        "category": "project",
        "lowMicrohours": 4000000,
        "highMicrohours": 12000000,
        "inputStatus": "measured"
      },
      {
        "category": "baseline",
        "lowMicrohours": 280000,
        "highMicrohours": 840000,
        "inputStatus": "measured"
      },
      { "category": "control", "lowMicrohours": 0, "highMicrohours": 0, "inputStatus": "measured" },
      { "category": "storage", "lowMicrohours": 0, "highMicrohours": 0, "inputStatus": "measured" },
      { "category": "evm", "lowMicrohours": 0, "highMicrohours": 0, "inputStatus": "measured" },
      { "category": "reserve", "lowMicrohours": 0, "highMicrohours": 0, "inputStatus": "measured" }
    ],
    "manualAdjustment": {
      "id": "scope-correction",
      "lowHours": -0.5,
      "highHours": -0.25,
      "adjustedHours": { "low": 3, "high": 13 },
      "adjustedDays": { "low": 0.3, "high": 1.7 },
      "ledger": {
        "category": "manual",
        "lowMicrohours": -500000,
        "highMicrohours": -250000,
        "inputStatus": "manual"
      },
      "calculationNote": "Pre-manual hours are 4 + 7×0.04 = 4.28 low and 12 + 7×0.12 = 12.84 high. Display floors the low whole hour and ceils the high whole hour. The signed adjustment contributes -0.50/-0.25 hours after reserve, then hours and days round outward."
    }
  },
