{
  "name": "audit-estimator",
  "version": "0.1.0",
  "private": true,
  "description": "A local Solidity audit-effort estimation CLI.",
  "bin": {
    "audit-estimator": "./dist/bin.js"
  },
  "files": [
    "dist",
    "schemas",
    "CHANGELOG.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas/config-v1.schema.json": "./schemas/config-v1.schema.json",
    "./schemas/model-v1.schema.json": "./schemas/model-v1.schema.json",
    "./schemas/result-v1.schema.json": "./schemas/result-v1.schema.json",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown --clean",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --project unit",
    "test:integration": "node scripts/test.mjs integration",
    "test:all": "node scripts/test.mjs all",
    "check": "node scripts/check.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "test:package": "node scripts/test.mjs package",
    "test:coverage": "vitest run --project unit --coverage",
    "boundaries:check": "node scripts/check-boundaries.mjs",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "schemas:generate": "pnpm build && node scripts/generate-schemas.mjs generate",
    "schemas:check": "pnpm build && node scripts/generate-schemas.mjs check"
  },
  "dependencies": {
    "@nomicfoundation/slang": "1.3.9",
    "commander": "15.0.0",
    "picomatch": "4.0.7",
    "smol-toml": "1.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "@types/picomatch": "4.0.3",
    "@vitest/coverage-v8": "5.0.4",
    "oxfmt": "0.73.0",
    "oxlint": "1.88.0",
    "oxlint-tsgolint": "7.0.2004",
    "tsdown": "0.23.1",
    "typescript": "7.0.2",
    "vitest": "5.0.4"
  },
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "packageManager": "pnpm@11.28.4"
}
